[Unit]
Description=Bridge published Strapi episodes into the AIC podcast pipeline
After=network-online.target aic-strapi.service
Wants=network-online.target aic-strapi.service

[Service]
Type=oneshot
User=ammonsfarm
Group=ammonsfarm
WorkingDirectory=/mnt/storage/aic
Environment=PYTHONUNBUFFERED=1
ExecStart=/mnt/storage/aic/.venv-pg/bin/python /mnt/storage/aic/scripts/process_episode_publish_requests.py --env-file /mnt/storage/aic/.env --podcast-env-file /mnt/storage/aic_podcast/.env --limit 1
TimeoutStartSec=3h 10m
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
