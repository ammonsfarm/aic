# Copy this file to /etc/aic/strapi-backup-replication.env as root:root mode
# 0600 only after creating the dedicated rclone crypt configuration and the
# separately held recovery kit described in README.md.
AIC_STRAPI_BACKUP_REPLICATION_ENABLED=0
RCLONE_CONFIG_PATH=/etc/aic/rclone-aic-strapi.conf
RCLONE_CRYPT_REMOTE=aic-strapi-crypt
OFF_HOST_REMOTE_CONFIRMED=NO
REMOTE_RETENTION_GENERATIONS=30
