[Unit]
Description=AIC Pastor Wood Strapi CMS
Requires=aic-strapi-schema.service
After=network-online.target aic-strapi-schema.service
Wants=network-online.target

[Service]
Type=simple
User=ammonsfarm
Group=ammonsfarm
WorkingDirectory=/mnt/storage/aic/services/jimwood-cms
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=1337
Environment=STRAPI_CMS_ROOT=/mnt/storage/aic/services/jimwood-cms
Environment=STRAPI_MEDIA_ROOT=/mnt/storage/pastorwood-media/strapi/uploads
Environment=AIC_API_TOKEN_OUTPUT_FILE=/run/aic-strapi/aic-api-token
EnvironmentFile=/etc/aic/strapi.env
ExecStartPre=/usr/local/libexec/aic-strapi/prepare-strapi-storage.sh
ExecStart=/usr/local/libexec/aic-strapi/with-aic-db-env.sh /mnt/storage/aic/services/jimwood-cms/node_modules/.bin/strapi start
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
RuntimeDirectory=aic-strapi
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
ReadOnlyPaths=/mnt/storage/aic
ReadWritePaths=/mnt/storage/aic/services/jimwood-cms/.tmp
ReadWritePaths=/mnt/storage/aic/services/jimwood-cms/public
ReadWritePaths=/mnt/storage/pastorwood-media/strapi
UMask=0027

[Install]
WantedBy=multi-user.target
