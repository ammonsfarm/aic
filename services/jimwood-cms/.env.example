HOST=127.0.0.1
PORT=1337
# Leave blank when Strapi is private to the AIC host. Public media is served by
# the AIC application, not by exposing the Strapi admin service.
PUBLIC_URL=
AIC_API_TOKEN_OUTPUT_FILE=/run/aic-strapi/aic-api-token

APP_KEYS=replace-one,replace-two,replace-three,replace-four
API_TOKEN_SALT=replace-with-random-value
ADMIN_JWT_SECRET=replace-with-random-value
TRANSFER_TOKEN_SALT=replace-with-random-value
ENCRYPTION_KEY=replace-with-random-value

DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=aic_strapi
DATABASE_USERNAME=aic_strapi
DATABASE_PASSWORD=replace-with-random-value
DATABASE_SCHEMA=public
DATABASE_SSL=false

# Upload provider settings are environment-owned. The public-cutover/ops lane
# must configure and verify durable storage before production content import.
FLAG_NPS=false
FLAG_PROMOTE_EE=false
FLAG_DOC_LINKS=false
