{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "default": "Abiding in Christ",
      "required": true
    },
    "headerLogo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "topNavigation": {
      "type": "component",
      "component": "navigation.navigation-item",
      "repeatable": true
    },
    "footerNavigation": {
      "type": "component",
      "component": "navigation.navigation-item",
      "repeatable": true
    },
    "utilityNavigation": {
      "type": "component",
      "component": "navigation.navigation-item",
      "repeatable": true
    },
    "footerText": {
      "type": "text"
    },
    "copyrightText": {
      "type": "string"
    },
    "showDonateButton": {
      "type": "boolean",
      "default": true
    },
    "donateButtonLabel": {
      "type": "string",
      "default": "Donate"
    },
    "donateButtonUrl": {
      "type": "string",
      "default": "/donate"
    },
    "donorDashboardUrl": {
      "type": "string",
      "default": "https://www.pastorwood.org/donor-dashboard/"
    },
    "subscriptionEnabled": {
      "type": "boolean",
      "default": true
    }
  }
}
