{
  "kind": "collectionType",
  "collectionName": "pastorwood_episodes",
  "info": {
    "singularName": "episode",
    "pluralName": "episodes",
    "displayName": "Radio Episode",
    "description": "Public audio episode metadata and processing state"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "trackId": { "type": "string", "unique": true },
    "episodeNumber": { "type": "integer", "min": 1 },
    "programDate": { "type": "date" },
    "summary": { "type": "text" },
    "description": { "type": "richtext" },
    "audio": { "type": "media", "multiple": false, "allowedTypes": ["audios"] },
    "externalAudioUrl": { "type": "string" },
    "durationSeconds": { "type": "integer", "min": 0 },
    "featuredImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "guests": { "type": "relation", "relation": "manyToMany", "target": "api::person.person" },
    "scriptureReferences": { "type": "component", "repeatable": true, "component": "content.scripture-reference" },
    "transcriptStatus": {
      "type": "enumeration",
      "enum": ["not-requested", "queued", "running", "completed", "failed", "skipped"],
      "default": "not-requested"
    },
    "intelligenceStatus": {
      "type": "enumeration",
      "enum": ["not-requested", "queued", "running", "completed", "failed", "skipped"],
      "default": "not-requested"
    },
    "vectorStatus": {
      "type": "enumeration",
      "enum": ["not-requested", "queued", "running", "completed", "failed", "skipped"],
      "default": "not-requested"
    },
    "publishDate": { "type": "datetime" },
    "scheduledFor": { "type": "datetime" },
    "legacyUrl": { "type": "string" },
    "archiveReason": { "type": "text" },
    "archivedAt": { "type": "datetime" },
    "seo": { "type": "component", "repeatable": false, "component": "seo.metadata" }
  }
}
