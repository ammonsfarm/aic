{
  "kind": "collectionType",
  "collectionName": "pastorwood_media_assets",
  "info": {
    "singularName": "media-asset",
    "pluralName": "media-assets",
    "displayName": "Media Asset",
    "description": "Editorial metadata for files managed by the Strapi upload library"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "asset": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["images", "files", "videos", "audios"] },
    "assetType": {
      "type": "enumeration",
      "enum": ["image", "audio", "video", "document", "download", "other"],
      "default": "image",
      "required": true
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["private", "internal", "public"],
      "default": "private",
      "required": true
    },
    "altText": { "type": "string" },
    "caption": { "type": "text" },
    "credit": { "type": "string" },
    "sourceUrl": { "type": "string" },
    "rights": { "type": "string" },
    "tags": { "type": "json" },
    "usageNotes": { "type": "text" },
    "legacyAttachmentId": { "type": "string", "unique": true },
    "legacyRelativePath": { "type": "string" },
    "checksumSha256": { "type": "string" },
    "archiveReason": { "type": "text" },
    "archivedAt": { "type": "datetime" }
  }
}
